{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Run PriceBreakoutScanner",
            "type": "debugpy",
            "request": "launch",
            "module": "price_breakout_scanner",
            "cwd": "${workspaceFolder}",
            "console": "integratedTerminal",
            "env": {
                "PYTHONPATH": "${workspaceFolder}/src"
            }
        },
        {
            "name": "Run PriceBreakoutScanner with Args",
            "type": "debugpy",
            "request": "launch",
            "module": "price_breakout_scanner",
            "cwd": "${workspaceFolder}",
            "console": "integratedTerminal",
            "env": {
                "PYTHONPATH": "${workspaceFolder}/src"
            },
            "args": [
                "--limit",
                "100",
                "--export",
                "reports/latest.xlsx"
            ]
        },
        {
            "name": "Python Debugger: Current File",
            "type": "debugpy",
            "request": "launch",
            "program": "${file}",
            "cwd": "${workspaceFolder}",
            "console": "integratedTerminal",
            "env": {
                "PYTHONPATH": "${workspaceFolder}/src"
            }
        }
    ]
}
